  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxnueel/sismos-mx.git"
  },
  "bugs": {
    "url": "https://github.com/mxnueel/sismos-mx/issues"
  },
  "homepage": "https://mxnueel.github.io/sismos-mx/",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
